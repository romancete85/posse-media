# Copiar a .env y completar. NUNCA commitear el .env real (ver .gitignore).

# --- App de LinkedIn (https://www.linkedin.com/developers/apps) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback
# Version de la Posts API (formato YYYYMM). LinkedIn rota ~12 meses; mantener actual.
LINKEDIN_VERSION=202606

# --- OAuth local (flujo de una sola vez) ---
OAUTH_CALLBACK_PORT=8765

# --- AWS / token store (SSM Parameter Store, SecureString) ---
AWS_REGION=us-east-1
# Path base del parametro donde viven los tokens (SecureString + KMS).
SSM_TOKEN_PARAM=/posse-pipeline/linkedin/tokens
# En CI, las credenciales AWS vienen de GitHub Secrets (access key). En local, del perfil/CLI de AWS.

# --- Backend del token store: "ssm" (prod/CI) | "local" (dev) ---
TOKEN_STORE_BACKEND=local
# Solo para el backend local (dev): archivo fuera del repo.
LOCAL_TOKEN_FILE=~/.config/posse-pipeline/tokens.json

# --- Contenido ---
CONTENT_DIR=content

# --- Generación con IA (produce siempre drafts; el gate humano sigue intacto) ---
# Texto: "ollama" (homelab, gratis) | "claude" (API, con créditos)
LLM_BACKEND=ollama
# Ollama del homelab: CT 120 en minipve2 (ver proxmox-ai-ops/docs/OLLAMA-AIBOX.md).
# ⚠️ DHCP .154 — conviene reserva de IP; si cambia, actualizá acá.
OLLAMA_HOST=http://192.168.100.154:11434
OLLAMA_MODEL=qwen2.5:14b  # mejor calidad (lento en CPU). qwen2.5:7b más rápido; llama3.2:3b el más rápido.
OLLAMA_KEEP_ALIVE=30m     # deja el modelo caliente (evita recarga ~24s tras 5 min idle)
OLLAMA_TIMEOUT=600        # segundos; prompts largos (repurpose/RAG) en 14b CPU tardan minutos
# Claude (solo si LLM_BACKEND=claude). Vacío -> el SDK usa el entorno.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
# Imágenes (Google): Imagen genera, Gemini visión escribe el alt (misma key).
GEMINI_API_KEY=
IMAGEN_MODEL=imagen-4.0-generate-001
GEMINI_VISION_MODEL=gemini-2.5-flash
# Alt text: "gemini" (rápido) | "ollama" (visión local en CT 120, ~80-90s/img en CPU, gratis)
ALT_BACKEND=gemini
OLLAMA_VISION_MODEL=llava:7b

# --- Cross-post: Mastodon (gratis, self-serve) ---
# Preferences > Development > New application (scopes: write:statuses + write:media) -> token.
MASTODON_INSTANCE=          # ej. https://mastodon.social  (sin barra final)
MASTODON_ACCESS_TOKEN=
MASTODON_MAX_CHARS=500      # límite de tu instancia (mastodon.social = 500)

# --- Cross-post: X/Twitter (API v2, tier PAGO ~USD 100/mes) ---
# developer.twitter.com -> app con OAuth 1.0a (Read+Write) -> las 4 claves.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_MAX_CHARS=280

# --- Auto-publish (publish-due): token compartido para el webhook que dispara n8n ---
# Lo usa scripts/webhook.py; n8n lo manda en el header X-Posse-Token. Poné algo random y largo.
POSSE_WEBHOOK_TOKEN=
